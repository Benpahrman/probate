# =====================================================================
# Gieni OS Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Ollama Configuration (Local / Private Open-Weights)
# ---------------------------------------------------------------------
# Host/URL of the Ollama server (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# Alias supported:
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Specific model to run for reasoning and investigation
# Examples installed on your system: hermes3:8b, qwen2.5:7b, phi4-mini:latest, qwen2.5:3b
OLLAMA_MODEL=hermes3:8b

# Optional: Force provider to Ollama even if Azure keys are present
# Choices: OLLAMA | AZURE_OPENAI | DETERMINISTIC_STATUTORY_ARE
# LLM_PROVIDER_OVERRIDE=OLLAMA

# ---------------------------------------------------------------------
# 2. Azure OpenAI Configuration (Enterprise Cloud Deployment)
# ---------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ---------------------------------------------------------------------
# 3. Database & Core Platform
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///database/gieni_os.db
NOTION_TOKEN=your_notion_token_here
NOTION_KB_DB_ID=3e0b5bd1-d90c-812c-9c65-d25cefd633a3
NOTION_CLIENTS_DB_ID=3e0b5bd1-d90c-810e-a326-de5677c60e18
NOTION_OPPORTUNITIES_DB_ID=3e0b5bd1-d90c-81e6-bb4d-c1bc60166a40
NOTION_COUNTIES_DB_ID=3e0b5bd1-d90c-8105-b6fd-ef9a8371d96b
NOTION_PIERCE_COUNTY_PAGE_ID=3e0b5bd1-d90c-814d-af6a-d971b052115d
AES_SECRET_KEY=your_32_char_aes_secret_key_here
DEMO_MODE=false

# ---------------------------------------------------------------------
# 4. Clerk Production Authentication
# ---------------------------------------------------------------------
# CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# CLERK_SECRET_KEY=your_clerk_secret_key_here


